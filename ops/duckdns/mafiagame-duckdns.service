[Unit]
Description=Update the MAFIAGAME DuckDNS IPv4 record
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
DynamicUser=yes
EnvironmentFile=-/etc/mafiagame/duckdns.env
StateDirectory=mafiagame-duckdns
StateDirectoryMode=0750
ExecStart=/usr/local/libexec/mafiagame/update-duckdns.sh
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
